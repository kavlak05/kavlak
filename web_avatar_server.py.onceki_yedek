from __future__ import annotations
from aiohttp import web


import asyncio
import json
from typing import Any, Callable, Coroutine
class WebAvatarServer:
    def __init__(self, *args, state_provider=None, chat_handler=None, cycle_handler=None, host: str = "127.0.0.1", port: int = 8080, http_host: str = None, http_port: int = None, **kwargs):
        if len(args) >= 1 and state_provider is None:
            state_provider = args[0]
        if len(args) >= 2 and chat_handler is None:
            chat_handler = args[1]
        if len(args) >= 3 and cycle_handler is None:
            cycle_handler = args[2]
        for k in ("state", "get_state", "provider"):
            if state_provider is None and k in kwargs:
                state_provider = kwargs[k]
        for k in ("on_chat", "chat", "handle_chat"):
            if chat_handler is None and k in kwargs:
                chat_handler = kwargs[k]
        for k in ("on_cycle", "cycle", "handle_cycle"):
            if cycle_handler is None and k in kwargs:
                cycle_handler = kwargs[k]
        self.state_provider = state_provider
        self.chat_handler = chat_handler
        self.cycle_handler = cycle_handler
        self.host = http_host or kwargs.get("host_ip") or host
        raw_port = http_port if http_port is not None else kwargs.get("web_port", port)
        self.port = int(raw_port if raw_port is not None else 8080)
        self.app = web.Application()
        self.app.router.add_get("/", self._handle_index)
        self.app.router.add_get("/api/state", self._handle_state)
        self.app.router.add_post("/api/chat", self._handle_chat)
        self.app.router.add_post("/api/cycle", self._handle_cycle)
        self.app.router.add_post("/api/speak", self._handle_speak)
        self._runner = None

    async def _handle_index(self, request: web.Request) -> web.Response:
        return web.Response(text=self._render_html(), content_type="text/html", charset="utf-8")

    async def _handle_state(self, request: web.Request) -> web.Response:
        st = self.state_provider() if callable(self.state_provider) else {}
        return web.json_response(st)

    async def _handle_chat(self, request: web.Request) -> web.Response:
        try:
            data = await request.json()
        except Exception:
            data = {}
        msg = (data.get("message") or data.get("text") or "").strip()
        if not msg:
            return web.json_response({"ok": False, "reply_text": "Boş mesaj alındı."}, status=400)
        res = await self.chat_handler(msg)
        if isinstance(res, dict):
            return web.json_response({
                "ok": True,
                "reply_text": res.get("reply_text") or res.get("reply") or res.get("text") or str(res),
                "visemes": res.get("visemes") or [],
                "emotion": res.get("emotion") or "neutral",
            })
        return web.json_response({"ok": True, "reply_text": str(res), "visemes": [], "emotion": "neutral"})

    async def _handle_cycle(self, request: web.Request) -> web.Response:
        res = await self.cycle_handler()
        return web.json_response({"ok": True, **(res if isinstance(res, dict) else {})})

    async def _handle_speak(self, request: web.Request) -> web.Response:
        import subprocess
        try:
            data = await request.json()
        except Exception:
            data = {}
        if data.get("stop"):
            subprocess.Popen(["killall", "say"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return web.json_response({"ok": True, "stopped": True})
        txt = (data.get("text") or "").strip()
        if txt:
            subprocess.Popen(["killall", "say"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.Popen(["say", txt])
        return web.json_response({"ok": True})

    async def start(self) -> web.AppRunner:
        self._runner = web.AppRunner(self.app)
        await self._runner.setup()
        await web.TCPSite(self._runner, self.host, self.port).start()
        return self._runner

    async def stop(self) -> None:
        if self._runner:
            await self._runner.cleanup()

    def _render_html(self) -> str:
        return '<!DOCTYPE html>\n<html lang="tr">\n<head>\n<meta charset="UTF-8" />\n<meta name="viewport" content="width=device-width, initial-scale=1.0" />\n<title>AETHER — Canlı Sesli Avatar</title>\n<style>\n  :root {\n    --bg: #070b14;\n    --panel: rgba(17, 25, 43, 0.82);\n    --border: rgba(148, 163, 184, 0.18);\n    --text: #f8fafc;\n    --muted: #94a3b8;\n    --accent: #38bdf8;\n    --accent2: #818cf8;\n    --ok: #22c55e;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif; }\n  body {\n    min-height: 100vh;\n    background: radial-gradient(circle at 20% 15%, rgba(56,189,248,0.16), transparent 45%),\n                radial-gradient(circle at 80% 80%, rgba(129,140,248,0.16), transparent 45%),\n                var(--bg);\n    color: var(--text);\n    display: flex;\n    justify-content: center;\n    padding: 24px 16px;\n  }\n  .app {\n    width: 100%;\n    max-width: 920px;\n    display: grid;\n    grid-template-columns: 310px 1fr;\n    gap: 20px;\n    align-items: start;\n  }\n  @media (max-width: 780px) { .app { grid-template-columns: 1fr; } }\n  .card {\n    background: var(--panel);\n    backdrop-filter: blur(18px);\n    border: 1px solid var(--border);\n    border-radius: 22px;\n    padding: 20px;\n    box-shadow: 0 20px 50px rgba(0,0,0,0.45);\n  }\n  .stage { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }\n  .orb {\n    width: 148px; height: 148px; border-radius: 50%;\n    background: linear-gradient(150deg, #172540, #0a101d);\n    border: 2px solid var(--accent);\n    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;\n    box-shadow: 0 0 28px rgba(56,189,248,0.25);\n    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;\n  }\n  .listening .orb { border-color: var(--ok); box-shadow: 0 0 34px rgba(34,197,94,0.42); }\n  .speaking .orb { border-color: var(--accent2); transform: scale(1.06); box-shadow: 0 0 36px rgba(129,140,248,0.45); }\n  .eyes { display: flex; gap: 22px; }\n  .eye { width: 11px; height: 11px; border-radius: 50%; background: #f8fafc; box-shadow: 0 0 10px var(--accent); }\n  .mouth { width: 32px; height: 6px; border-radius: 999px; background: linear-gradient(90deg, var(--accent), var(--accent2)); transition: all 0.08s ease; }\n  .status {\n    font-size: 12.5px; color: #cbd5e1;\n    background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border);\n    padding: 6px 12px; border-radius: 999px;\n  }\n  .btns { display: flex; flex-direction: column; gap: 9px; width: 100%; }\n  button {\n    border: none; border-radius: 12px; padding: 11px 14px;\n    font-size: 13.5px; font-weight: 600; cursor: pointer;\n    transition: transform 0.1s ease, opacity 0.15s ease;\n  }\n  button:active { transform: scale(0.98); }\n  .btn-p { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #04101f; }\n  .btn-s { background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.45); }\n  .btn-g { background: rgba(30, 41, 59, 0.85); color: var(--text); border: 1px solid var(--border); }\n  .chat { display: flex; flex-direction: column; height: 530px; }\n  .chat-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--border); }\n  .msgs { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 12px 0; }\n  .m { max-width: 82%; padding: 10px 14px; border-radius: 14px; font-size: 13.5px; line-height: 1.45; word-wrap: break-word; }\n  .u { align-self: flex-end; background: #2563eb; color: #fff; }\n  .b { align-self: flex-start; background: rgba(30, 41, 59, 0.9); border: 1px solid var(--border); }\n  form { display: flex; gap: 8px; padding-top: 10px; border-top: 1px solid var(--border); }\n  input {\n    flex: 1; background: rgba(15, 23, 42, 0.9); border: 1px solid var(--border);\n    border-radius: 12px; padding: 10px 12px; color: var(--text); font-size: 13.5px; outline: none;\n  }\n  input:focus { border-color: var(--accent); }\n</style>\n</head>\n<body>\n<div class="app">\n  <div class="card stage" id="stage">\n    <div class="orb">\n      <div class="eyes"><div class="eye"></div><div class="eye"></div></div>\n      <div class="mouth" id="mouth"></div>\n    </div>\n    <div class="status" id="status">Hazır</div>\n    <div class="btns">\n      <button class="btn-p" id="talkBtn" type="button" onclick="toggleTalk()">Konuşmaya Başla</button>\n      <button class="btn-s" id="stopBtn" type="button" onclick="stopAll()">Durdur</button>\n      <button class="btn-g" type="button" onclick="runCycle()">Otonom Döngü</button>\n    </div>\n  </div>\n  <div class="card chat">\n    <div class="chat-head">\n      <b>AETHER Canlı Sesli Avatar</b>\n      <span style="font-size:12px;color:#94a3b8">Aktif</span>\n    </div>\n    <div class="msgs" id="msgs">\n      <div class="m b">Hazırım. "Konuşmaya Başla" butonuna basıp konuşabilir veya aşağıdan mesaj yazabilirsin.</div>\n    </div>\n    <form onsubmit="onSubmit(event)">\n      <input id="inp" type="text" placeholder="Mesaj yaz..." autocomplete="off" />\n      <button class="btn-p" type="submit">Gönder</button>\n    </form>\n  </div>\n</div>\n<script>\nlet live = false;\nlet rec = null;\nlet mTimer = null;\nlet oTimer = null;\n\nfunction setSt(t) {\n  const e = document.getElementById("status");\n  if (e) e.textContent = t;\n}\n\nfunction addMsg(who, t) {\n  const b = document.getElementById("msgs");\n  if (!b || !t) return;\n  const d = document.createElement("div");\n  d.className = "m " + (who === "u" ? "u" : "b");\n  d.textContent = t;\n  b.appendChild(d);\n  b.scrollTop = b.scrollHeight;\n}\n\nfunction animateMouth(v, txt) {\n  const st = document.getElementById("stage");\n  const m = document.getElementById("mouth");\n  if (mTimer) clearInterval(mTimer);\n  if (!m) return;\n  const dur = Math.min(11000, Math.max(1200, (txt || "").length * 60));\n  if (st) st.classList.add("speaking");\n  const t0 = Date.now();\n  mTimer = setInterval(() => {\n    if (Date.now() - t0 >= dur) {\n      clearInterval(mTimer);\n      mTimer = null;\n      m.style.height = "6px";\n      m.style.width = "32px";\n      if (st) st.classList.remove("speaking");\n      return;\n    }\n    m.style.height = (8 + Math.floor(Math.random() * 16)) + "px";\n    m.style.width = (24 + Math.floor(Math.random() * 14)) + "px";\n  }, 90);\n}\n\nasync function speak(txt) {\n  const clean = (txt || "").trim();\n  if (!clean) return;\n  animateMouth([], clean);\n  try {\n    await fetch("/api/speak", {\n      method: "POST",\n      headers: {"Content-Type": "application/json"},\n      body: JSON.stringify({text: clean})\n    });\n  } catch (e) {}\n  await new Promise((r) => {\n    oTimer = setTimeout(r, Math.min(10000, Math.max(1400, clean.length * 60)));\n  });\n}\n\nasync function sendText(txt) {\n  const clean = (txt || "").trim();\n  if (!clean) return;\n  addMsg("u", clean);\n  setSt("Yanıt bekleniyor...");\n  try {\n    const res = await fetch("/api/chat", {\n      method: "POST",\n      headers: {"Content-Type": "application/json"},\n      body: JSON.stringify({message: clean, text: clean})\n    });\n    const d = await res.json();\n    const rep = d.reply_text || d.reply || d.text || "Yanıt alındı.";\n    addMsg("b", rep);\n    await speak(rep);\n  } catch (e) {\n    setSt("Bağlantı hatası");\n  } finally {\n    if (live) {\n      listen();\n    } else {\n      setSt("Hazır");\n    }\n  }\n}\n\nfunction onSubmit(e) {\n  e.preventDefault();\n  const i = document.getElementById("inp");\n  if (!i) return;\n  const v = i.value.trim();\n  if (!v) return;\n  i.value = "";\n  sendText(v);\n}\n\nfunction listen() {\n  if (!live) return;\n  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;\n  if (!SR) {\n    setSt("Tarayıcı ses tanımayı desteklemiyor");\n    live = false;\n    updBtn();\n    return;\n  }\n  try { if (rec) rec.abort(); } catch (e) {}\n  rec = new SR();\n  rec.lang = "tr-TR";\n  rec.interimResults = false;\n  rec.maxAlternatives = 1;\n\n  const st = document.getElementById("stage");\n  if (st) st.classList.add("listening");\n  setSt("Seni dinliyorum...");\n\n  rec.onresult = (ev) => {\n    if (st) st.classList.remove("listening");\n    const sp = (ev.results[0][0].transcript || "").trim();\n    if (!sp) {\n      if (live) listen();\n      return;\n    }\n    sendText(sp);\n  };\n\n  rec.onerror = (ev) => {\n    if (st) st.classList.remove("listening");\n    if (!live) return;\n    if (ev.error === "not-allowed" || ev.error === "service-not-allowed") {\n      setSt("Mikrofon izni gerekli");\n      live = false;\n      updBtn();\n      return;\n    }\n    setTimeout(() => { if (live) listen(); }, 500);\n  };\n\n  rec.onend = () => {\n    if (st) st.classList.remove("listening");\n  };\n\n  try { rec.start(); } catch (e) {}\n}\n\nfunction updBtn() {\n  const b = document.getElementById("talkBtn");\n  if (b) b.textContent = live ? "Konuşmayı Kapat" : "Konuşmaya Başla";\n}\n\nasync function toggleTalk() {\n  if (live) {\n    await stopAll();\n    return;\n  }\n  live = true;\n  updBtn();\n  await speak("Seni dinliyorum.");\n  if (live) listen();\n}\n\nasync function stopAll() {\n  live = false;\n  updBtn();\n  if (oTimer) { clearTimeout(oTimer); oTimer = null; }\n  if (mTimer) { clearInterval(mTimer); mTimer = null; }\n  const st = document.getElementById("stage");\n  const m = document.getElementById("mouth");\n  if (st) st.classList.remove("speaking", "listening");\n  if (m) { m.style.height = "6px"; m.style.width = "32px"; }\n  try { if (rec) rec.abort(); } catch (e) {}\n  try {\n    await fetch("/api/speak", {\n      method: "POST",\n      headers: {"Content-Type": "application/json"},\n      body: JSON.stringify({stop: true})\n    });\n  } catch (e) {}\n  setSt("Durduruldu");\n}\n\nasync function runCycle() {\n  setSt("Döngü çalışıyor...");\n  try {\n    await fetch("/api/cycle", {method: "POST"});\n    setSt("Döngü tamamlandı");\n  } catch (e) {\n    setSt("Döngü hatası");\n  }\n}\n</script>\n</body>\n</html>'
